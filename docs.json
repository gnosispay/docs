{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Gnosis Pay",
  "colors": {
    "primary": "#766DE5",
    "light": "#9994ED",
    "dark": "#1A1751"
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "logo": {
    "light": "/static/img/logo-dark.svg",
    "dark": "/static/img/logo-light.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Contact Support",
        "href": "mailto:support@example.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign up as Partner",
      "href": "https://dashboard.example.com/signup"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["intro", "whybuild", "architecture"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "https://api.gnosispay.com/api-docs/spec.json"
      },
      {
        "tab": "Changelog",
        "pages": ["changelog/index"]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/gnosispay",
      "website": "https://gnosispay.com/",
      "github": "https://github.com/gnosispay"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["javascript", "curl", "python", "go", "java", "ruby"]
    }
  }
}
